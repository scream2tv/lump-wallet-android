{
  "name": "lump-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lump Wallet: a simple, mobile-first wallet for the Midnight network.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --base /wallet/",
    "serve": "node server/static.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "guard": "node server/node-guard.mjs",
    "cap:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@midnightntwrk/dapp-connector-api": "4.1.0",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "2.2.0",
    "buffer": "^6.0.3",
    "effect": "3.22.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "7.8.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}

# Copy to .env.production.local (never committed) and fill in. See docs/SELF-HOSTING.md.

# The host (and port, if not 443) of YOUR wallet server, without a scheme. It must serve, over TLS:
#   /wallet/   server/static.mjs
#   /indexer/  a Midnight indexer (v4 API)
#   /node      server/node-guard.mjs in front of a Midnight node
VITE_WALLET_HOST=wallet.example.org

# A name for your indexer's database. Change it whenever the indexer is resynced from scratch.
# Must equal LW_INDEXER_ID of server/state-bot.mjs.
VITE_INDEXER_ID=mainnet-1

# Optional: where your indexer has the ledger-9 fork in its DUST timeline (docs/SELF-HOSTING.md).
# VITE_DUST_FORK_CURSOR=

# Optional: name single services instead of, or on top of, VITE_WALLET_HOST.
# VITE_INDEXER_URL=https://indexer.example.org/api/v4/graphql
# VITE_INDEXER_WS_URL=wss://indexer.example.org/api/v4/graphql/ws
# VITE_NODE_WS=wss://node.example.org
# VITE_PROVER_URL=https://prover.example.org
